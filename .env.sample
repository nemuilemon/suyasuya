# local 開発用。.env にコピーして設定する。
# docker compose up --build -d で起動する。

# suyasuya 専用の Gemini API key
GEMINI_API_KEY=

# Gemini Flash（2026-09-16 時点の最新安定版）
GEMINI_MODEL=gemini-3.8-flash

# PostgreSQL（local Compose 内から接続する想定）
DB_HOST=postgres
DB_PORT=5432
DB_NAME=suyasuya
# local 開発用。本番では接続構成に合わせて変更する。
DB_SSLMODE=disable

# DB 初期化・migration 用。アプリの通常接続には使わない。
# Compose の POSTGRES_DB には DB_NAME を渡す。
POSTGRES_USER=suyasuya_admin
POSTGRES_PASSWORD=replace_with_admin_password

# control 用 role
DB_CONTROL_USER=suyasuya_control
DB_CONTROL_PASSWORD=replace_with_control_password

# agent 用 role（読み書きの権限は docs/architecture.md に従う）
DB_AGENT_USER=suyasuya_agent
DB_AGENT_PASSWORD=replace_with_agent_password

# Cloud Storage（local dev から使用する非公開 bucket）
GCS_BUCKET=

# V4 signed URL の署名用 service account のメールアドレス
# control がこの account の署名権限を使う設計。Gemini API key とは別。
GCS_SIGNER_SERVICE_ACCOUNT=

# 署名付き URL の有効期間（秒）
GCS_SIGNED_URL_TTL_SECONDS=900

# 画像サイズ上限（bytes、10 MiB）。URL 発行時・upload 完了確認時に検証する。
UPLOAD_MAX_BYTES=10485760

# bucket の CORS 設定用。browser の origin をカンマ区切りで指定する。
# 例: https://dev.example.com,http://localhost:8080
# この値だけでは bucket の CORS は変更されない。構築処理で適用する。
GCS_CORS_ALLOWED_ORIGINS=

# この認証ファイルだけをコンテナへ read-only mount する。
# service account key または署名権限を持つ ADC。Gemini API key とは別。
GCP_CREDENTIALS_FILE=/home/your-user/.config/gcloud/application_default_credentials.json
LOCAL_UID=1000
LOCAL_GID=1000

# 初回起動で作る管理者。12文字以上のパスワードを設定する。
APP_USERNAME=nemuilemon
APP_PASSWORD=replace_with_login_password
APP_PORT=8080
# HTTPS の Tunnel 公開時は true。localhost の HTTP では false。
APP_SECURE_COOKIE=false
